# ClawBody Configuration
# Give your OpenClaw AI agent a physical robot body!

# ==============================================================================
# VOICE BACKEND
# ==============================================================================
# local: local STT -> OpenClaw -> local TTS (default, no OpenAI key)
# openai: existing OpenAI Realtime speech-to-speech backend
VOICE_BACKEND=local

# ==============================================================================
# REQUIRED: OpenClaw Gateway
# ==============================================================================
# The URL where your OpenClaw gateway is running
# If running on the same machine as the robot, use the host machine's IP
OPENCLAW_GATEWAY_URL=ws://localhost:18789

# Your OpenClaw gateway authentication token
# Find this in ~/.openclaw/openclaw.json under gateway.token
OPENCLAW_TOKEN=your-gateway-token

# Agent ID to use (default: main)
OPENCLAW_AGENT_ID=main

# Session key for conversation context - IMPORTANT!
# Use "main" (default) to share context with WhatsApp and other DM channels
# This allows the robot to be aware of all your conversations
OPENCLAW_SESSION_KEY=main

# ==============================================================================
# OPTIONAL: Voice Settings
# ==============================================================================
# Local STT (install with: pip install -e ".[local_voice]")
STT_BACKEND=faster-whisper
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Leave blank for automatic language detection
STT_LANGUAGE=

# Local TTS. Download a Piper voice and point this at its .onnx file.
TTS_BACKEND=piper
PIPER_EXECUTABLE=piper
PIPER_MODEL=en_US-lessac-medium.onnx
PIPER_SAMPLE_RATE=22050

# Energy VAD / turn detection tuning
VAD_THRESHOLD=0.015
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250

# OpenAI settings are used only with VOICE_BACKEND=openai.
# Get a key at https://platform.openai.com/api-keys (Realtime access required).
OPENAI_API_KEY=
# OpenAI Realtime voice (alloy, echo, fable, onyx, nova, shimmer, cedar)
OPENAI_VOICE=cedar

# OpenAI model for Realtime API
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17

# ==============================================================================
# OPTIONAL: Features
# ==============================================================================
# Enable/disable features (true/false)
ENABLE_CAMERA=true
ENABLE_OPENCLAW_TOOLS=true

# Local posture reminder (optional; requires: pip install -e ".[mediapipe_vision]")
# Frames stay in memory and are never uploaded. Best with the camera side-on or at a three-quarter angle.
ENABLE_POSTURE_MONITOR=false
POSTURE_MODEL_PATH=models/mediapipe/pose_landmarker_lite.task
POSTURE_FORWARD_HEAD_THRESHOLD=0.20
POSTURE_SUSTAIN_SECONDS=4.0
POSTURE_ALERT_COOLDOWN_SECONDS=30.0
POSTURE_CHECK_INTERVAL_SECONDS=0.5
# Diagnostic only: queue one antenna flutter immediately after startup, then set back to false.
POSTURE_TEST_ALERT_ON_START=false
